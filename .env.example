# Copy to .env (never commit it) or export these in your shell.

# TypeSafe System One API (Jev). Needed for the `jev` arm in a real run.
TYPESAFE_API_KEY=

# Anthropic API. Needed for the `haiku` and `sonnet` arms in a real run.
ANTHROPIC_API_KEY=

# Optional: any OpenAI-compatible endpoint you add in configs/arms.toml
# names its own key variable via `api_key_env`, for example:
# MY_ENDPOINT_API_KEY=
